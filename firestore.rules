rules_version = '2';

// Each signed-in user reads and writes only their own redacted drafts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/drafts/{draftId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['title', 'platform', 'redactedNote', 'redactedLetter', 'held', 'leaked', 'detectedOn', 'draftedOn', 'payloadSha256', 'createdAt'])
        && request.resource.data.redactedNote is string
        && request.resource.data.redactedNote.size() < 20000
        && request.resource.data.redactedLetter is string
        && request.resource.data.redactedLetter.size() < 20000
        && request.resource.data.title is string
        && request.resource.data.platform in ['web', 'ios']
        && request.resource.data.held is int
        && request.resource.data.leaked is int
        && request.resource.data.detectedOn in ['on-device', 'patterns-only']
        && request.resource.data.draftedOn in ['IN_CLOUD', 'ON_DEVICE']
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
